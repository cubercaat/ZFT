# ===== ZFT — Chorraha uchun AI marketing markazi — sozlamalar =====
# Bu faylni nusxalang:  cp .env.example .env   va .env ni to'ldiring.
# .env ni HECH KIMGA yubormang, chatga yozmang, GitHub'ga yuklamang.

# --- 1. Telegram (majburiy) ---
BOT_TOKEN=                 # @BotFather bergan token
BOT_USERNAME=              # botning nomi, @ siz (masalan ChorrahaTestBot)
OWNER_ID=                  # sizning Telegram ID raqamingiz (@userinfobot dan oling)
CHANNEL_ID=                # bo'sh qoldiring: botni kanalga admin qiling va paneldagi «Ulanishlar» da tanlang
GROUP_ID=                  # bo'sh qoldiring: botni guruhga admin qiling va «Ulanishlar» da tanlang
SITE_URL=https://chorrahaa.uz

# --- 2. Claude API (ixtiyoriy, lekin tavsiya) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=8    # shu summaga yetsa AI o'chadi, tizim shablon bilan davom etadi
AI_WEB_SEARCH=true         # dushanba kuni trendlarni qidirish (~3 qidiruv/hafta)

# --- 3. AI Studio: professional AI video (fal.ai — bitta kalit, ko'p model) ---
FAL_KEY=                   # fal.ai → Dashboard → API Keys (hisobga 10-20$ to'ldiring)
VIDEO_MONTHLY_BUDGET_USD=25   # oylik video budjeti; paneldan yoki /budjet 60 bilan istalgan payt o'zgaradi
VIDEO_MODEL=fal-ai/veo3.1/fast   # boshqa variantlar: alibaba/wan-3.0/text-to-video, lightricks/ltx-2.5/text-to-video/fast
VIDEO_PRICE_PER_SEC=0.10   # tanlangan modelning narxi ($/soniya) — fal.ai sahifasidan tekshiring
VIDEO_RESOLUTION=720p
SCENE_SECONDS=6
IMAGE_MODEL=fal-ai/flux/schnell
IMAGE_PRICE=0.004
DIRECTOR_MODEL=claude-sonnet-5-5   # ssenariy yozuvchi (sifatli); arzonroq: claude-haiku-5-5
SLOTS=12:30,20:00          # kuniga e'lon vaqtlari (Toshkent)
GEN_LEAD_MINUTES=150       # e'londan necha daqiqa oldin video tayyorlanadi (tasdiqlashga vaqt)

# --- 3b. Video fayllar uchun ochiq manzil (Instagram va TikTok uchun) ---
PUBLIC_MEDIA_URL=          # masalan https://media.chorrahaa.uz  (deploy/nginx.conf ga qarang)

# --- 4. Instagram: paneldagi «Ulanishlar» → «Instagramni ulash» (parolsiz, rasmiy OAuth) ---
IG_APP_ID=                 # developers.facebook.com dagi ilova (bir martalik sozlash, README 6-qadam)
IG_APP_SECRET=
PANEL_URL=https://panel.chorrahaa.uz   # qaytish manzili shu asosda: PANEL_URL/oauth/instagram/callback
GRAPH_VERSION=v23.0
# Eski usul (ixtiyoriy): token qo'lda bo'lsa
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- 5. TikTok: «Ulanishlar» → «TikTokni ulash» ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY   # TikTok ilova auditi o'tgach: PUBLIC_TO_EVERYONE
TIKTOK_ACCESS_TOKEN=       # eski usul (ixtiyoriy)

# --- 6. Ish tartibi (Toshkent vaqti) ---
REPORT_HOUR=22             # kunlik hisobot
GROUP_QUIZ_HOURS=8,13,20   # guruhga avtomatik viktorina
AUTO_PUBLISH=false         # avtopilot: true bo'lsa videolar tasdiqsiz chiqadi (paneldan ham yoqiladi)
TTS_VOICE=uz-UZ-MadinaNeural   # yoki uz-UZ-SardorNeural (erkak ovozi)

# --- 7. Boshqaruv paneli (brauzerda: https://panel.chorrahaa.uz) ---
PANEL_PASSWORD=            # kamida 10 belgili kuchli parol; bo'sh qolsa panel o'chiq
PANEL_PORT=8090

SERVER_MONTHLY_USD=6.5     # Moliya hisobiga qo'shiladigan server narxi

# --- 8. Referal ---
REF_GOAL=3
REF_REWARD_TEXT=3 ta do'st taklif qilganlar haftalik reytingda alohida e'lon qilinadi
REF_CONTEST_PRIZE=maxsus sovg'a   # oylik referal konkursi g'oliblariga (har oyning 1-kuni e'lon qilinadi)

# --- 9. Botdagi imtihon simulyatsiyasi (rasmiy qoidalarga moslab tekshiring!) ---
EXAM_QUESTIONS=20          # bitta imtihondagi savollar soni
EXAM_MAX_ERRORS=2          # nechta xatoga ruxsat
EXAM_MINUTES=25            # vaqt chegarasi, daqiqa

# --- 10. Instagram izohlari (avto-javob) ---
# Instagram'ni ulashda izoh va DM ruxsatlari ham so'raladi; eski ulanish bo'lsa «Qayta ulash» ni bosing.
IG_REPLY_MAX_RUN=15        # bir tekshiruvda ko'pi bilan nechta javob (har 20 daqiqada)
IG_REPLY_MAX_DAY=150       # kunlik limit (spam deb bloklanmaslik uchun)
IG_DM_KEYWORDS=test,havola,link,bot,ssilka,ссылка,savollar,+   # shu so'zni yozganga DM'da bot havolasi boradi
IG_DM_TEXT=                # bo'sh qolsa standart matn
QUALITY_MIN=6              # e'londan oldingi baho shundan past bo'lsa, video bir marta qayta yasaladi
